---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"video"> {
  src: string;
}

const {
  src,
  caption,
  controls = true,
  loop = true,
  playsinline = true,
  muted = true,
  autoplay = true,
  ...videoProps
} = Astro.props;
---

<video
  class="aspect-video h-auto w-full rounded-lg"
  src={src}
  controls={controls}
  loop={loop}
  playsinline={playsinline}
  muted={muted}
  autoplay={autoplay}
  {...videoProps}></video>

  {caption && (
    <figcaption class="mt-2 text-center text-base font-medium text-gray-700 dark:text-gray-300">
      {caption}
    </figcaption>
  )}
</figure>
